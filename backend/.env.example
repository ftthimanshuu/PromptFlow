PORT=5000
NODE_ENV=development

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (from Google AI Studio - free tier)
GEMINI_API_KEY=your-gemini-api-key

# Groq API Key (from https://console.groq.com/keys - ultra-fast free tier)
GROQ_API_KEY=your-groq-api-key

# Telegram Bot Token (optional for testing, from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

